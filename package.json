{
  "name": "spotify-filters",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/free-port.js 3001",
    "dev": "next dev -H 127.0.0.1 -p 3001",
    "predev:clean": "node scripts/free-port.js 3001",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev -H 127.0.0.1 -p 3001",
    "build": "next build",
    "prestart": "node scripts/free-port.js 3001",
    "start": "next start -H 127.0.0.1 -p 3001",
    "lint": "next lint",
    "test": "vitest run",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "next": "15.2.0",
    "openai": "^4.85.1",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.2.0",
    "prisma": "^6.4.1",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
